{% extends 'inc/mabase.html.twig' %}

{% block contenudelapage %}
<form method="POST">
    <label for="firstname">Prénom</label>
    <input type="text" required id="firstname" name="firstname" />

    <label for="lastname">Nom</label>
    <input type="text" required id="lastname" name="lastname" />
    
    <label for="age">Âge</label>
    <input type="number" min="1" max="128" required id="age" name="age" />

    <input type="submit" value="S'enregistrer" />
</form>

{% if firstname != null and lastname != null and age != null %}
<div>
    <h1>Résultats du formulaire</h1>
    <ul>
        <li>{{ firstname }}</li>
        <li>{{ lastname }}</li>
        <li>{{ age }}</li>
    </ul>
</div>
{% endif %}

{% if error %}
<p style="color: red">{{ error }}</p>
{% endif %}

{% endblock %}