{% extends 'inc/mabase.html.twig' %}

{% block titredelapage %}Liste des utilisateurs{% endblock %}

{% block contenudelapage %}
<h1>Liste des utilisateurs</h1>
<table>
    <thead>
        <tr>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Age</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for user in users %}
        <tr>
            <td>{{ user.firstname }}</td>
            <td>{{ user.lastname }}</td>
            <td>{{ user.age }}</td>
            <td><a href="{{ path('user_show', {id: user.id}) }}">Voir</a></td>
            <td><a href="{{ path('user_delete', {id: user.id}) }}">Supprimer</a></td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}