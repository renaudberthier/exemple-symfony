{% extends 'inc/mabase.html.twig' %}

{% block titredelapage %}Créer un produit{% endblock %}

{% block contenudelapage %}
<form method="POST">
    <label for="name">Nom</label>
    <input type="text" maxlength="255" required id="name" name="name" />
    
    <label for="description">Description</label>
    <input type="text" maxlength="255" required id="description" name="description" />

    <label for="price">Prix</label>
    <input type="number" min="0" max="9999.99" step="0.01" required id="price" name="price" />

    <input type="submit" value="Créer un produit" />
</form>
{% endblock %}